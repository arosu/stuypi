# Source this from your shell (e.g., add `source ~/stuypi-services/.env` to ~/.zshrc)
# before running `docker compose up -d` in any service directory.

# Immich — generate at http://<immich>/user-settings/api-keys
export IMMICH_API_KEY=

# Beszel — your Beszel user account password
export BESZEL_PASSWORD=

# Pi-hole — admin password
export PIHOLE_PASSWORD=

# Speedtest Tracker
# APP_KEY: Laravel app key, generate with: docker run --rm php:cli sh -c \
#   "echo base64:$(php -r 'echo base64_encode(random_bytes(32));')"
export SPEEDTEST_TRACKER_APP_KEY=
# API_KEY: create from your speedtest-tracker user profile -> API Tokens
export SPEEDTEST_TRACKER_API_KEY=

# Plex — pull from your server's Preferences.xml (PlexOnlineToken="...")
export PLEX_TOKEN=

# arr-stack — each app's API key (Settings → General → Security → API Key)
export SONARR_API_KEY=
export RADARR_API_KEY=
export PROWLARR_API_KEY=
export SABNZBD_API_KEY=
export BAZARR_API_KEY=

# Mealie — Settings → API Tokens → Generate (per-user, doesn't expire)
export MEALIE_API_KEY=

# Home Assistant — long-lived access token.
# Generate at https://home.alexandrurosu.com → Profile (bottom-left) →
# Security → Long-Lived Access Tokens → Create Token.
export HASS_TOKEN=

# Beszel agent — pre-shared token between hub and agent.
# Reissue from the Beszel UI (Systems → Add System) if you suspect leakage.
export BESZEL_AGENT_TOKEN=

# bin/rclone_discord.py — Discord webhook + Uptime Kuma push token used by
# the nightly Backblaze sync notifier.
export RCLONE_DISCORD_WEBHOOK_URL=
export KUMA_PUSH_URL_BACKBLAZE=

# Caddy (Phase 2 only) — Cloudflare API token with Zone:DNS:Edit permission
# for alexandrurosu.com. Used for Let's Encrypt DNS-01 challenge.
# Create at: https://dash.cloudflare.com/profile/api-tokens (template: Edit zone DNS)
export CLOUDFLARE_API_TOKEN=
